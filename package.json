{
  "name": "@iwonz/ywtc",
  "version": "2.0.1",
  "type": "module",
  "description": "Resumable, loss-aware transfers between Yandex Wiki, Confluence, Markdown, and static HTML",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iwonz/ywtc.git"
  },
  "bugs": {
    "url": "https://github.com/iwonz/ywtc/issues"
  },
  "homepage": "https://github.com/iwonz/ywtc#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ywtc": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "docs/assets/readme-header.png",
    ".env.example",
    "ywtc.config.example.yaml",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.5.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run release:check && npm run security:audit && npm run typecheck && npm run lint && npm run knip && npm test && npm run test:browser && npm run build && npm run package:verify && npm run spec:validate",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "commitlint": "commitlint",
    "migrate": "tsx src/cli.ts migrate",
    "package:verify": "node --import tsx scripts/package-validation.ts",
    "prepack": "npm run release:check && npm run build",
    "release:check": "node scripts/release-check.mjs",
    "release:bootstrap": "node --import tsx scripts/npm-bootstrap.ts",
    "release:validate": "node --import tsx scripts/validate-release-tag.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "workspace:init": "node --import tsx src/cli.ts init --workdir ."
  },
  "dependencies": {
    "@archiver/archiver": "^0.3.0",
    "@commander-js/extra-typings": "^15.0.0",
    "@diplodoc/transform": "4.78.6",
    "axios": "1.20.0",
    "cheerio": "1.2.0",
    "commander": "^15.0.0",
    "dotenv": "18.0.7",
    "form-data": "4.0.6",
    "linkify-it": "6.1.0",
    "listr2": "^11.2.0",
    "p-queue": "^10.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@fission-ai/openspec": "1.14.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "fast-check": "^4.10.2",
    "knip": "6.41.0",
    "nock": "15.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "katex": "0.19.0",
    "lodash": "4.18.1",
    "markdown-it": {
      ".": "13.0.2",
      "linkify-it": "5.0.2"
    },
    "markdownlint": "0.41.1",
    "svgo": "3.3.5"
  }
}
