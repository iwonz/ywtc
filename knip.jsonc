{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "tests/**/*.test.ts",
    "tests/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.ts",
    "report-ui/src/**/*.ts",
    "report-ui/src/**/*.tsx",
    "report-ui/src/**/*.css",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts"
  ]
}
